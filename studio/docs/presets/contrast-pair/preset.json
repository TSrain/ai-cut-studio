    "registryFit": 0,
    "remotionRisk": 0,
    "hyperframesRisk": 1
  },
  "audit": {
    "keyframes": [
      "start",
      "end"
    ]
  },
  "motion": {
    "character": "deliberate",
    "springAccents": 0,
    "timeline": [
      {
        "phase": "enter",
        "seconds": 0.07,
        "action": "左列(退灰侧)先入 0.4s——对照两侧逐个出,绝不同时淡入(taste.md 最高频节奏律)",
        "easing": "ENTER"
      },
      {
        "phase": "enter",
        "seconds": 0.4,
        "action": "中线自上而下画出 0.4s",
        "easing": "ENTER"
      },
      {
        "phase": "enter",
        "seconds": 0.63,
        "action": "中缝符号圆盘 knockout 入场 0.33s,缩放无弹跳",
        "easing": "ENTER"
      },
      {
        "phase": "enter",
        "seconds": 0.83,
        "action": "右列(点亮侧)入场 0.4s + accent 下划线",
        "easing": "ENTER"
      },
      {
        "phase": "hold",
        "seconds": "elastic",
        "action": "静止读取"
      }
    ],
    "exit": {
      "seconds": 0.35,
      "easing": "smoothstep",
      "endFrame": "N-1",
      "implementation": "PresetExit",
      "description": "末段平滑溶出，最后实际帧透明度归零；原生回收动作保留，透明度只执行一次。"
    }
  },
  "variants": {
    "symbol": {
      "label": "中缝符号",
      "type": "enum",
      "values": [
        "≠",
        "→",
        "VS"
      ],
      "default": "≠",
      "description": "中缝符号:≠ 否定对照 / → 演进 / VS 对抗",
      "hint": "≠ 是否定对照，→ 是演进，VS 是对抗"
    }
  },
  "slots": {
    "leftLabel": {
      "label": "左侧标签",
