{
  "version": 2,
  "id": "contrast-pair",
  "name": "左右对照",
  "engine": "remotion",
  "compositionId": "PresetContrastPair",
  "componentSource": "templates/remotion-base/src/presets/ContrastPair.tsx",
  "status": "verified",
