  "tags": [
    "type",
    "layout",
    "state",
    "preset"
  ],
  "signals": {
    "framePrecision": 1,
    "dataBinding": 0,
    "continuity": 1,
    "captions": 0,
    "audioSync": 0,
    "webUi": 0,
